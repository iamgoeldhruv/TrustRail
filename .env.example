# ==========================================
# OTARI CONFIGURATION
# ==========================================

OTARI_BASE_URL=https://your-otari-host/api/v1
OTARI_API_KEY=your_workspace_api_key
OTARI_MCP_SERVER_ID=your_mcp_server_id

# ==========================================
# AI MODEL CONFIGURATION
# ==========================================

TR_PLANNER_MODEL=your_planner_model
TR_COMPILER_MODEL=your_compiler_model

# ==========================================
# TRUSTRAIL CONFIGURATION
# ==========================================

TR_ADMIN_TOKEN=replace_with_secure_token
TR_DB_PATH=./data/trustrail.db

# ==========================================
# GITHUB MCP SERVER
# ==========================================

MCP_GITHUB_PAT=your_github_personal_access_token
